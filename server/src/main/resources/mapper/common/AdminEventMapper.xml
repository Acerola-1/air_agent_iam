<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.airagent.iam.common.mapper.AdminEventMapper">
    <select id="insertAudit" resultType="long" affectData="true" flushCache="true" useCache="false">
        SELECT iam_auth.write_audit(
            #{tenantId,jdbcType=OTHER}, #{actorId,jdbcType=OTHER}, 'human',
            #{action}, #{targetType}, #{targetId}, CAST(#{detailJson} AS jsonb), #{requestId})
    </select>
    <select id="enqueueRedisDeletes" resultType="long" affectData="true" flushCache="true" useCache="false">
        SELECT iam_auth.enqueue_outbox('redis_delete_keys', CAST(#{payloadJson} AS jsonb))
    </select>
</mapper>
