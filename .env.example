# IAM 独立服务本机验收环境配置形状（复制为 .env.local 后填入真实值，chmod 600）。
# 本文件只描述变量形状：不提供任何默认生产口令，所有密钥值必须本地生成。
# 生成示例：openssl rand -base64 32

# ---- HTTP（仅回环；不得改 0.0.0.0）----
IAM_HTTP_PORT=19100

# ---- PostgreSQL（Apple Container 自有实例，端口 19132）----
IAM_PG_HOST=127.0.0.1
IAM_PG_PORT=19132
IAM_PG_DB=iam
IAM_PG_MIGRATE_USER=iam_migrate
IAM_PG_MIGRATE_PASSWORD=
IAM_PG_APP_USER=iam_app
IAM_PG_APP_PASSWORD=
IAM_DB_POOL_MAX=12

# ---- Redis（Apple Container 自有实例，端口 19179）----
IAM_REDIS_HOST=127.0.0.1
IAM_REDIS_PORT=19179
IAM_REDIS_PASSWORD=
IAM_REDIS_DB=0

# ---- 会话/票据密钥（本地生成，每环境独立）----
IAM_RT_KEYS_KID=local-1
IAM_RT_KEYS_SECRET=
IAM_CSRF_SECRET=

# ---- 首启 bootstrap（仅空库首次迁移生效；不设通用默认口令）----
IAM_BOOTSTRAP_ACCOUNT=
IAM_BOOTSTRAP_DISPLAY_NAME=
IAM_BOOTSTRAP_PASSWORD=

# ---- 合成 SSO 两客户端（回环精确回调；每客户端独立密钥）----
IAM_SSO_CLIENT_AGENT_SECRET=
IAM_SSO_CLIENT_KB_SECRET=

# 合成 runtime 内部客户端（本机）；留空则不预置
IAM_INTERNAL_RUNTIME_CLIENT_ID=
IAM_INTERNAL_RUNTIME_CLIENT_SECRET=
