{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://air-agent.local/contracts/schemas/requests.schema.json",
  "title": "v1 请求体集合",
  "$defs": {
    "login": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account",
        "password",
        "realm",
        "audience"
      ],
      "properties": {
        "account": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "password": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "realm": {
          "const": "workforce"
        },
        "audience": {
          "enum": [
            "air-agent",
            "knowledge",
            "iam-admin"
          ]
        }
      }
    },
    "switch_tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "expected_ctx_version"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_ctx_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "renew": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_ctx_version"
      ],
      "properties": {
        "expected_ctx_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "change_password": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_password",
        "new_password"
      ],
      "properties": {
        "old_password": {
          "type": "string",
          "minLength": 1
        },
        "new_password": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        }
      }
    },
    "introspect": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "subject_token",
            "audience"
          ]
        },
        {
          "required": [
            "execution_context",
            "audience"
          ]
        }
      ],
      "properties": {
        "subject_token": {
          "type": "string",
          "minLength": 16
        },
        "execution_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verification_ref",
            "expected_revisions"
          ],
          "properties": {
            "verification_ref": {
              "type": "string",
              "format": "uuid"
            },
            "expected_revisions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "user_auth_revision",
                "tenant_auth_revision",
                "membership_revision",
                "session_ctx_version"
              ],
              "properties": {
                "user_auth_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "tenant_auth_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "membership_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "session_ctx_version": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "expected_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenant_id",
            "ctx_version"
          ],
          "properties": {
            "tenant_id": {
              "type": "string",
              "format": "uuid"
            },
            "ctx_version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "include_execution_context": {
          "type": "boolean"
        }
      }
    },
    "runtime_ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_token",
        "audience",
        "target_tenant_id",
        "expected_ctx_version"
      ],
      "properties": {
        "subject_token": {
          "type": "string",
          "minLength": 16
        },
        "audience": {
          "const": "langgraph-runtime"
        },
        "target_tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_ctx_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sso_exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticket",
        "redirect_uri"
      ],
      "properties": {
        "ticket": {
          "type": "string",
          "minLength": 16
        },
        "redirect_uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "page_query": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 20
        },
        "cursor": {
          "type": "string"
        }
      }
    },
    "expected_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "ctx_version"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "ctx_version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "create_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_context",
        "code",
        "name_zh",
        "permissions"
      ],
      "properties": {
        "expected_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "tenant_id",
            "ctx_version"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "tenant_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "ctx_version": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(:[a-z][a-z0-9_-]*)+$",
          "minLength": 3,
          "maxLength": 160
        },
        "name_zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sort": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "parent_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "name_zh",
              "grantable_to_tenants"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 3,
                "maxLength": 200
              },
              "name_zh": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "grantable_to_tenants": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "update_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_context",
        "expected_revision"
      ],
      "properties": {
        "expected_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "tenant_id",
            "ctx_version"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "tenant_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "ctx_version": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "name_zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sort": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "disabled"
          ]
        }
      }
    },
    "update_entitlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_context",
        "expected_revision",
        "expected_tenant_revision",
        "status"
      ],
      "properties": {
        "expected_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "tenant_id",
            "ctx_version"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "tenant_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "ctx_version": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "expected_tenant_revision": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "revoked"
          ]
        }
      }
    }
  }
}
