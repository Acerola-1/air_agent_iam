{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://air-agent.local/contracts/schemas/identity.schema.json",
  "title": "iam.identity.v1 人类身份（me 与有效 introspection 共用）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "active", "issuer", "audience", "principal", "user",
    "session", "current_tenant", "membership", "platform_roles", "tenant_roles",
    "permissions", "revisions", "context_version", "platform_admin",
    "context_usable", "needs_tenant_selection", "evaluated_at"
  ],
  "properties": {
    "schema_version": { "const": "iam.identity.v1" },
    "active": { "type": "boolean" },
    "issuer": { "type": "string", "minLength": 1 },
    "audience": {
      "type": "string",
      "enum": ["air-agent", "knowledge", "iam-admin", "langgraph-runtime"]
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "realm"],
      "properties": {
        "type": { "const": "human" },
        "id": { "type": "string", "format": "uuid" },
        "realm": { "const": "workforce" }
      }
    },
    "user": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "account", "display_name", "status"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "account": { "type": "string", "minLength": 3, "maxLength": 64 },
        "display_name": { "type": "string" },
        "status": { "enum": ["active", "disabled"] }
      }
    },
    "session": { "$ref": "#/$defs/session" },
    "current_tenant": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "code", "name", "status"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "code": { "type": "string", "minLength": 1 },
            "name": { "type": "string" },
            "status": { "enum": ["active", "suspended"] }
          }
        }
      ]
    },
    "membership": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "tenant_id", "department_id", "status", "revision"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "tenant_id": { "type": "string", "format": "uuid" },
            "department_id": { "type": ["string", "null"], "format": "uuid" },
            "status": { "enum": ["active", "disabled"] },
            "revision": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "platform_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string", "pattern": "^platform_[a-z0-9_]+" },
          "name": { "type": "string" }
        }
      },
      "uniqueItems": true
    },
    "tenant_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string", "pattern": "^tenant_[a-z0-9_]+" },
          "name": { "type": "string" }
        }
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "revisions": { "$ref": "#/$defs/revisions" },
    "context_version": { "type": "integer", "minimum": 1 },
    "platform_admin": { "type": "boolean" },
    "context_usable": { "type": "boolean" },
    "needs_tenant_selection": { "type": "boolean" },
    "evaluated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "needs_tenant_selection": { "const": true } } },
      "then": {
        "properties": {
          "current_tenant": { "type": "null" },
          "membership": { "type": "null" },
          "tenant_roles": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "context_usable": { "const": false } },
             "required": ["context_usable"] },
      "then": { "properties": { "permissions": { "not": { "contains": { "pattern": "^(tenant|knowledge|agent):" } } } } }
    }
  ],
  "$defs": {
    "session": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "id", "ctx_version", "created_at", "expires_at",
        "absolute_expires_at", "idle_expires_at"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "ctx_version": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "absolute_expires_at": { "type": "string", "format": "date-time" },
        "idle_expires_at": { "oneOf": [
          { "type": "string", "format": "date-time" },
          { "type": "null" }
        ] }
      }
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_auth_revision", "tenant_auth_revision",
        "membership_revision", "session_ctx_version"
      ],
      "properties": {
        "user_auth_revision": { "type": "integer", "minimum": 0 },
        "tenant_auth_revision": { "type": "integer", "minimum": 0 },
        "membership_revision": { "type": "integer", "minimum": 0 },
        "session_ctx_version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
